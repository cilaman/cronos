# Production: TLS via Let's Encrypt + HTTP basic auth on the app.
# Required env: DOMAIN, BASIC_AUTH_USER, BASIC_AUTH_HASH (bcrypt).
# Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext '<password>'

{$DOMAIN} {
    # Public paths: landing page, static info pages, crawler files — no auth.
    @private not path / /robots.txt /sitemap.xml /about.html /terms.html /privacy.html
    basicauth @private {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    # Landing page at root — serve landing.html without auth.
    handle / {
        root * /srv
        rewrite * /landing.html
        file_server
    }

    # React SPA lives under /app/. Fallback to index.html for client-side routing.
    @app path /app /app/*
    handle @app {
        uri strip_prefix /app
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Serve remaining static files (robots.txt, sitemap.xml, about.html, etc.).
    handle {
        root * /srv
        file_server
    }
}
