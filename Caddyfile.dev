# Local development: plain HTTP on :80, no Caddy-level auth.
#
# The FastAPI layer uses fail-closed auth: if CRONOS_BASIC_AUTH_USER +
# CRONOS_BASIC_AUTH_PASSWORD are unset it returns HTTP 503 (misconfiguration),
# NOT a silent allow. To disable auth for local dev, set:
#
#   CRONOS_AUTH_DISABLED=true
#
# This is the ONLY supported way to run without credentials. Do NOT rely on
# Caddyfile.dev's absent basicauth block as the sole auth bypass — it only
# removes the edge gate; the app-level check still fires.
#
# Production config is in `Caddyfile` and is mounted via the prod compose overlay.

{
    auto_https off
}

:80 {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle / {
        root * /srv
        rewrite * /landing.html
        file_server
    }

    @app path /app /app/*
    handle @app {
        uri strip_prefix /app
        root * /srv
        try_files {path} /index.html
        file_server
    }

    handle {
        root * /srv
        file_server
    }
}
