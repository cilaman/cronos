# Local development: plain HTTP on :80, no Caddy-level auth.
# Authentication is handled at the FastAPI layer via CRONOS_BASIC_AUTH_USER /
# CRONOS_BASIC_AUTH_PASSWORD env vars (disabled when unset — default for dev).
# Production config is in `Caddyfile` and is mounted via the prod compose overlay.

{
    auto_https off
}

:80 {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle / {
        root * /srv
        rewrite * /landing.html
        file_server
    }

    @app path /app /app/*
    handle @app {
        uri strip_prefix /app
        root * /srv
        try_files {path} /index.html
        file_server
    }

    handle {
        root * /srv
        file_server
    }
}
