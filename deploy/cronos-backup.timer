[Unit]
Description=Daily Cronos data backup
Requires=cronos-backup.service

[Timer]
# 03:17 every day, with a small randomised delay so a fleet of VPSes
# does not all hit storage at the same minute.
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
