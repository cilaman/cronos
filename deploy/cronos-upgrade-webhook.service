[Unit]
Description=Cronos upgrade webhook (Docker-bridge HTTP trigger)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
WorkingDirectory=/data/spaces/cronos-development
# Optional shared secret — set the same value in .env as UPGRADE_WEBHOOK_SECRET
# EnvironmentFile=/data/spaces/cronos-development/.env
Environment=UPGRADE_SCRIPT=/data/spaces/cronos-development/upgrade.sh
ExecStart=/usr/bin/python3 /data/spaces/cronos-development/deploy/upgrade-webhook.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
