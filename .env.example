# Production env for Cronos. Copy to .env on the VPS and fill in values.
# Loaded by `docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up`.
#
# Do NOT put CLAUDE_CODE_OAUTH_TOKEN here — it lives in ~/.config/claude/env
# (chmod 600) and is loaded directly into the backend container. See
# deploy/VPS_SETUP.md §4.

# Public hostname the site will serve on. Must have a DNS A/AAAA record
# pointing at this VPS before first start so Caddy can obtain a TLS cert.
DOMAIN=cronos.example.com

# HTTP basic-auth username (any string).
BASIC_AUTH_USER=admin

# Bcrypt hash of the password. Generate with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-password-here'
#
# IMPORTANT: docker compose interpolates `$VAR` inside .env values, so a raw
# bcrypt hash like $2a$14$abc... gets parsed as three (empty) variable refs.
# Escape every `$` as `$$` when pasting. Example:
#   real hash:    $2a$14$TxGxYeXXN0i...
#   put in .env:  $$2a$$14$$TxGxYeXXN0i...
BASIC_AUTH_HASH=

# Application-layer HTTP Basic Auth for FastAPI (a second check behind Caddy).
# Auth is FAIL-CLOSED: requests (except /api/health) get 503 unless a username
# plus a password credential is configured. To run without auth in dev, set
# CRONOS_AUTH_DISABLED=true instead — that is the only supported bypass.
#
# Two ways to supply the password — pick ONE:
#   (preferred) CRONOS_BASIC_AUTH_HASH — reuse the SAME bcrypt hash as
#     BASIC_AUTH_HASH above (same `$$`-escaping). No plaintext anywhere; the
#     app verifies the incoming password against the hash. When set, it wins.
#   (fallback)  CRONOS_BASIC_AUTH_PASSWORD — the PLAINTEXT password.
# CRONOS_BASIC_AUTH_USER must equal BASIC_AUTH_USER so one browser login
# satisfies both the Caddy edge and the app.
CRONOS_BASIC_AUTH_USER=admin
CRONOS_BASIC_AUTH_HASH=
CRONOS_BASIC_AUTH_PASSWORD=
# CRONOS_AUTH_DISABLED=true   # dev-only: skip the app-layer check entirely

# Personal access token for HTTPS git operations in repo-linked spaces.
# Single-user setup — clone and push both use this token.
#
# Least-privilege credential model (use fine-grained PATs whenever possible):
#
#   Operation       Required scope (fine-grained PAT)   Classic PAT alternative
#   ─────────────── ─────────────────────────────────── ────────────────────────
#   git clone/fetch Contents:read  (per repo)           repo:read (all repos!)
#   git push        Contents:write (per repo)           repo      (all repos!)
#
# DO NOT grant: admin:*, workflow, packages, or any organisation-level scope.
# A fine-grained PAT scoped to a specific repository is strongly preferred over
# a classic "repo" PAT — if the token is compromised, the attacker can only
# write to the repos you explicitly listed, not your entire account.
#
# GitHub setup:
#   https://github.com/settings/personal-access-tokens → "Fine-grained tokens"
#   Select the specific repo → Repository permissions:
#     Contents: Read and write   ← needed for push
#
# GitLab: project/group access token with `write_repository`.
#
# Preferred future path: GitHub App installation tokens (short-lived, scoped
# per installation — see deploy/VPS_SETUP.md §5.3 for details).
#
# Leave empty for public repos or SSH-only setups.
# Will move to per-user / per-space storage once Cronos supports multiple operators.
CRONOS_GIT_TOKEN=

# Mandatory shared secret for the upgrade webhook (deploy/upgrade-webhook.py).
# When set, all webhook requests must include X-Upgrade-Secret header matching
# this value; unset → all requests return 403 Forbidden.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=
